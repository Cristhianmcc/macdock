<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Manifiesto del ejecutable. Declara a las claras tres cosas que el antivirus y
     Windows miran: quien es el programa, que NO pide administrador y para que
     versiones de Windows esta hecho. La version la reescribe build.ps1 al compilar. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="3.8.0.0" name="MacDock.app" type="win32" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker = arranca con los permisos del usuario, sin pedir elevacion.
             Asi no hay ninguna ventana de UAC al abrirlo ni al instalarlo. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 10 y 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Rutas largas (mas de 260 caracteres) en el Finder y las pilas. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

</assembly>
